# ============================================================
# DocAudit Agent 运行时配置
#
# 复制成 .env 后按需修改(.env 已被 .gitignore 排除,不要提交)。
#
# 本文件的默认值是**推荐的真实引擎组合**(MinerU + Milvus + 你的模型 API):
#   - 工作台跑审核必须在界面填入你自己的 API Key(或显式点「载入服务端已配置的 Key」);
#   - 只跑测试与评测则不需要任何 Key —— 单测进程不读 .env,评测强制离线合成语料。
# 想快速体验离线基线,把下面三个开关都设成 mock(见文件末尾「离线/测试」段)。
# ============================================================

# ---------------- 大模型(字段抽取) ----------------
# 工作台默认要求"用户自己填 Key";这里的配置供接口 /api/v1 与"显式载入服务端配置"使用。
# 换成其它 OpenAI 兼容服务时改 BASE_URL 与模型名即可。
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_API_KEY=replace-with-your-key
MODEL_NAME=deepseek-chat
MODEL_TIMEOUT_SECONDS=30

# LLM 字段抽取护栏
MODEL_EXTRACTION_MAX_ATTEMPTS=2
MODEL_EXTRACTION_MIN_CONFIDENCE=0.7

# ---------------- OCR(图片/扫描件识别) ----------------
# 推荐本地 MinerU:免费、离线,发票不出内网。需要你已安装 MinerU(它自带一个 venv):
#   MINERU_EXE=<你的 MinerU venv>/Scripts/mineru.exe   (Linux/macOS: .../bin/mineru)
#   MODELSCOPE_CACHE=<模型缓存目录,首次运行会下载约 1GB>
# 强烈建议先起常驻服务(scripts/start_mineru_api.bat),再配 MINERU_API_URL:
#   常驻服务实测单张 18~28 秒;不配此项则每次自起临时服务,实测约 115 秒/张。
OCR_ENGINE=mineru
MINERU_EXE=replace-with-your-mineru-executable
MODELSCOPE_CACHE=replace-with-your-model-cache-dir
MINERU_BACKEND=pipeline
MINERU_API_URL=http://127.0.0.1:8321

# 其它 OCR 选项(按需启用,注释掉上面那段):
# OCR_ENGINE=auto
# auto = 按材料难度自动路由:困难/手写 → mineru,清晰 → tesseract,失败降级
#
# OCR_ENGINE=tesseract
# TESSERACT_EXE=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_LANG=chi_sim+eng
# TESSERACT_DATA_DIR=<你的 tessdata 目录>(仓库不带语言包,见 README「中文 OCR 语言包」)
# OCR_PREPROCESS=1            # 图片预处理(灰度/放大/二值化)开关
#
# OCR_ENGINE=http             # 自建/第三方 OCR 网关(需 base64 传图)
# OCR_HTTP_URL=https://ocr.example.com/v1/recognize
# OCR_HTTP_API_KEY=replace-with-your-ocr-key
# OCR_HTTP_TEXT_PATH=data.text
# OCR_HTTP_TIMEOUT=60
# 发票专用接口通常直接返回结构化字段:配 fields_path + field_map 更准(docs/OCR_INTEGRATION.md)
# OCR_HTTP_FIELDS_PATH=words_result
# OCR_HTTP_FIELD_MAP={"invoice_number":"InvoiceNum","invoice_date":"InvoiceDate","invoice_amount":"TotalAmount"}
# OCR_HTTP_HEADERS={"X-Api-Key":"xxx"}
# 拿到 key 后可用 scripts/check_ocr_http.py 一条命令验证接口通不通
#
# OCR_ENGINE=baidu            # 百度智能云增值税发票识别(云端:发票会离开本机,注意合规)
# BAIDU_OCR_API_KEY=<your-api-key>
# BAIDU_OCR_SECRET_KEY=<your-secret-key>
# BAIDU_OCR_URL=https://aip.baidubce.com/rest/2.0/ocr/v1/vat_invoice

# ---------------- RAG(制度检索) ----------------
# milvus: 稠密向量检索(bge-m3),需要 requirements-rag.txt 与已建索引:
#   pip install -r requirements-rag.txt
#   BGE_MODEL_DIR=<bge-m3 权重目录> python -m app.rag.build_index
# 注意:bge-m3 需要你自己下载(MIT 许可,~2GB)。
RAG_MODE=milvus
BGE_MODEL_DIR=replace-with-your-bge-m3-dir

# RAG 融合开关(可选)。默认 0 = 只用稠密通道;>0 时启用稠密+稀疏加权融合。
# 为什么默认稠密优先:小语料下稀疏通道的 top1 常与语义无关,等权 RRF 会把无关 chunk
# 抬到第 1 名(依据见 app/rag/vector_store.py 的 SPARSE_WEIGHT_ENV 注释)。
# RAG_SPARSE_WEIGHT=0.3

# RAG 重排(可选增强)。实体重排(条款里的城市 vs 查询城市)始终开启,零依赖;
# 交叉编码器需另下 bge-reranker 权重(~2GB),不配就自动只用实体重排,不影响流程。
# BGE_RERANKER_DIR=replace-with-your-bge-reranker-dir   # 或把权重放到 data/rag/bge-reranker-v2-m3
# RAG_RERANK=0               # 显式关闭交叉编码器这一层
# RAG_BGE_FP16=1             # bge 系列权重用 fp16 加载(省一半内存,CPU 上可能更慢)

# 其它 RAG 选项:
# RAG_MODE=local              # 只用仓库内制度切片做本地检索,零额外依赖
# RAG_MODE=mock               # 规则匹配基线(最省事,但不做向量检索)
# 检索失败时的降级链(自动,无需配置):milvus → local → mock,原因写进审核 trace 的 rag: 行

# ---------------- 离线/测试(不需要任何 Key) ----------------
# 只想跑通流程或跑测试/评测时,把三个开关设成 mock 即可(测试与评测本来就是强制离线)。
# MODEL_PROVIDER=mock
# OCR_ENGINE=mock
# RAG_MODE=mock

# ---------------- 其它 ----------------
# AUTH_MODE=off               # enforce = 开启最小 RBAC(按角色与任务归属鉴权)
# API_PORT=8000
# WEB_PORT=8500
# AUDIT_TASK_DB=data/runtime/audit_tasks.sqlite3
