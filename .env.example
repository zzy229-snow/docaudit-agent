# Default offline mode. Safe for local development and tests.
MODEL_PROVIDER=mock

# OpenAI-compatible model API settings.
# Fill these only after you buy or obtain an API key.
# MODEL_PROVIDER=openai-compatible
# MODEL_BASE_URL=https://api.example.com/v1
# MODEL_API_KEY=replace-with-your-key
# MODEL_NAME=replace-with-model-name
MODEL_TIMEOUT_SECONDS=30

# LLM field extraction guardrails.
MODEL_EXTRACTION_MAX_ATTEMPTS=2
MODEL_EXTRACTION_MIN_CONFIDENCE=0.7

# OCR route.
# Use mock only for local deterministic tests. For production-like runs, use tesseract,
# http OCR service, or mineru according to your deployment.
# auto = 按材料难度自动路由(任务④):困难/手写 → mineru,清晰 → tesseract,失败降级 mock。
OCR_ENGINE=mock
# OCR_ENGINE=auto
# OCR_ENGINE=tesseract
# TESSERACT_EXE=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_LANG=chi_sim+eng
# TESSERACT_DATA_DIR=<你的 tessdata 目录>(仓库不带语言包,见 README「中文 OCR 语言包」)
# OCR_PREPROCESS=1            # 图片预处理(灰度/放大/二值化)开关;质量自适应引擎会按难度启用

# OCR_ENGINE=http
# OCR_HTTP_URL=https://ocr.example.com/v1/recognize
# OCR_HTTP_API_KEY=replace-with-your-ocr-key
# OCR_HTTP_TEXT_PATH=data.text
# OCR_HTTP_TIMEOUT=60
# 发票专用接口通常直接返回结构化字段:配 fields_path + field_map 更准(详见 docs/OCR_INTEGRATION.md)
# OCR_HTTP_FIELDS_PATH=words_result
# OCR_HTTP_FIELD_MAP={"invoice_number":"InvoiceNum","invoice_date":"InvoiceDate","invoice_amount":"TotalAmount"}
# OCR_HTTP_HEADERS={"X-Api-Key":"xxx"}
# 拿到 key 后可用 scripts/check_ocr_http.py 一条命令验证接口通不通

# OCR_ENGINE=mineru
# 本地 MinerU(免费、离线,发票不出内网)。需要你自己装好 MinerU 并指向它:
# MINERU_EXE=<你的 venv>/Scripts/mineru.exe
# MODELSCOPE_CACHE=<模型缓存目录,首次运行会自动下载约 1GB>
# MINERU_BACKEND=pipeline
# 强烈建议先起常驻服务(scripts\start_mineru_api.bat),再把下面的地址指过去:
#   常驻服务:实测单张 18~28 秒;不配此项则每次自起临时服务,实测约 115 秒/张
# MINERU_API_URL=http://127.0.0.1:8321

# 百度智能云 增值税发票识别(可选,云端:发票会离开本机,注意合规)
# 需在百度智能云开通「增值税发票识别」,用 API Key + Secret Key 换 access_token
# OCR_ENGINE=baidu
# BAIDU_OCR_API_KEY=<your-api-key>
# BAIDU_OCR_SECRET_KEY=<your-secret-key>
# BAIDU_OCR_URL=https://aip.baidubce.com/rest/2.0/ocr/v1/vat_invoice

# RAG route.
# mock: deterministic demo baseline.
# local: real local retrieval over policy chunks, no external service.
# milvus: vector hybrid retrieval, requires bge-m3 and Milvus Lite index.
RAG_MODE=mock
# RAG_MODE=local
# RAG_MODE=milvus
# BGE_MODEL_DIR=D:\path\to\bge-m3
